<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        CAMERA dipakai untuk memindai halaman braille. Pemindaian tetap berjalan
        sepenuhnya di perangkat memakai brailly.tflite: tidak ada kode di
        aplikasi ini yang mengunggah foto hasil pindai ke mana pun.

        INTERNET diperlukan sejak materi video pembelajaran di Jalur Kuis
        diputar lewat YouTube IFrame Player, yang berjalan di dalam WebView.
        Perlu dicatat bahwa dengan adanya izin ini, jaminan "foto pindai tidak
        bisa meninggalkan perangkat" tidak lagi dapat diverifikasi pengguna
        hanya dari daftar izin aplikasi. Satu-satunya trafik jaringan yang
        dilakukan aplikasi adalah pemutaran video oleh WebView di
        VideoLessonScreen.
    -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
        RECORD_AUDIO dipakai fitur dikte (voice-to-text) di layar Terjemah.
        Audionya diproses oleh layanan pengenalan suara bawaan sistem, bukan
        oleh Brailly, dan aplikasi hanya menerima teks hasil transkripsinya.
        Perekaman hanya berjalan selama satu ucapan setelah tombol mikrofon
        ditekan; tidak ada mode mendengarkan terus-menerus.
    -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <uses-feature android:name="android.hardware.camera.any" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <!--
        Sejak Android 11 daftar paket lain tidak lagi terlihat secara penuh.
        Tanpa deklarasi ini TextToSpeech tidak menemukan mesin suara apa pun
        dan SpeechRecognizer.isRecognitionAvailable() selalu mengembalikan
        false, sehingga fitur bacakan dan dikte mati tanpa pesan kesalahan
        yang bisa ditelusuri.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>


    <application
        android:name=".BraillyApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Brailly">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Brailly"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>